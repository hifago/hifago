#!/usr/bin/env bash
# Hook git pre-commit — régénère le manifeste documentaire quand un document change.
#
# POURQUOI (revue de CI du 2026-09-19). `docs/ai-index.json` et `docs/INDEX.md` sont GÉNÉRÉS puis
# COMMITTÉS : tout commit qui touche un docs/*.md peut les périmer (taille, statut, plage de la §0
# d'une spec…). Or les deux fichiers les plus souvent touchés du dépôt sont `docs/journal/<mois>.md`
# et `docs/backlog.md`, parce que CLAUDE.md §12 IMPOSE de les mettre à jour en fin de session. La
# règle du projet garantissait donc un `docs:check` rouge à quasi chaque session : 3 des 15 derniers
# échecs du job `lint`, et l'index était encore périmé sur main le 2026-09-19.
#
# Plutôt que de VÉRIFIER après coup un fichier que le processus périme structurellement, on le
# REGÉNÈRE au moment où il le périme. `docs:check` reste en CI comme filet.
#
# `--staged` : la génération lit l'INDEX git, pas l'arbre de travail — une modification non mise en
# scène ne doit pas entrer dans le manifeste commité (la CI relit le contenu commité).
# Déclenché aussi par une suppression (`D`) et par une modification du générateur lui-même.
#
# FUSIONS (vérifié le 2026-09-28 dans un worktree jetable). Les deux fichiers générés sont une
# fonction pure du contenu de docs/ (aucune date) : une fusion SANS conflit les combine donc
# exactement comme une régénération le ferait. Deux specs voisines modifiées de part et d'autre
# produisent un conflit sur leurs lignes adjacentes : `git add docs/INDEX.md docs/ai-index.json`
# puis `git commit` — ce hook régénère alors depuis le contenu fusionné. Pas de hook
# pre-merge-commit : git n'inclut PAS dans le commit de fusion ce qu'il met en scène (essayé,
# la carte restait périmée) ; pas de pilote de fusion « ours » : il masquerait le conflit et
# committerait une carte périmée en silence. Après un rebase, `npm run docs:check` (le pre-push
# le lance de toute façon).
#
# Contournable par `git commit --no-verify`, comme le pre-push.

set -uo pipefail

racine="$(git rev-parse --show-toplevel)"
cd "$racine" || exit 0

# Rien à faire si aucun document ni le générateur n'est mis en scène — la quasi-totalité des
# commits de code.
if ! git diff --cached --name-only --diff-filter=ACMRD | grep -qE '^(docs/.*\.md|scripts/docs_index\.js)$'; then
  exit 0
fi

# Le générateur est du JS nu sans dépendance : seul `node` est requis (un worktree frais n'a pas
# de node_modules, et ce n'est pas une raison pour sauter la régénération en silence).
command -v node >/dev/null 2>&1 || exit 0

echo "pre-commit : un document a changé, régénération du manifeste (docs_index.js --build --staged)…"

if ! node scripts/docs_index.js --build --staged; then
  echo
  echo "✗ La régénération a échoué — il y a un vrai problème dans les en-têtes \`---\` des documents." >&2
  echo "  Corriger ce que le message ci-dessus indique, puis recommitter." >&2
  exit 1
fi

# Mis en scène seulement s'ils ont réellement bougé, pour ne pas gonfler le commit pour rien.
if ! git diff --quiet -- docs/ai-index.json docs/INDEX.md; then
  git add docs/ai-index.json docs/INDEX.md
  echo "  → docs/ai-index.json et docs/INDEX.md régénérés et ajoutés au commit."
fi
