NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique absolue de la vitrine (apps/web/lib/seo/siteUrl.ts) : metadataBase, canonical,
# hreflang et sitemap. Même variable, même valeur qu'apps/admin/.env.example. À poser sur CHAQUE
# environnement déployé — absente, ces URL retombent sur http://localhost:3100, et en production
# (VERCEL_ENV=production) le build échoue (lib/seo/siteUrl.ts).
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3100

# Spec 19 §0 Tranche 1 — paiement Mercado Pago (acompte). Compte développeur Tus Integraciones,
# credentials TEST- en local/sandbox, APP_USR- en prod. Jamais NEXT_PUBLIC_* : ces deux secrets ne
# sont utilisés que côté serveur (apps/web/lib/mercadopago/client.ts, jamais exposés au navigateur
# — Checkout Pro fonctionne par simple redirection vers init_point, aucun SDK client nécessaire).
MERCADOPAGO_ACCESS_TOKEN=
# Secret configuré côté "Notificaciones webhooks" du compte Mercado Pago — sert à vérifier
# x-signature (apps/web/app/api/payments/webhook/route.ts). Sans lui, le webhook refuse tout
# (échec fermé), jamais un webhook accepté sans secret configuré.
MERCADOPAGO_WEBHOOK_SECRET=

# Simulateur de paiement — émule un paiement réussi/échoué sans toucher Mercado Pago (aucun
# identifiant requis, apps/web/lib/mercadopago/mock.ts). Bloqué en production déclarée
# (isProductionSite() : VERCEL_ENV=production) même si posé par erreur ; ACTIF partout ailleurs dès
# qu'il vaut "true", préprod comprise (VERCEL_ENV y vaut "preview") — c'est ainsi qu'il a été
# utilisé sur staging du 2026-09-14 au 2026-09-20. Off par défaut.
MERCADOPAGO_MOCK_MODE=

# Spec 21 — connecteur LobbyPMS. Absente : se replie sur https://api.lobbypms.com (comportement
# prod normal). En test/local, pointée vers un serveur de fixtures local (packages/e2e-support/src/
# pmsFixtureServer.ts) — jamais le vrai LobbyPMS depuis un test automatisé (aucun sandbox n'existe,
# spec 21 §10 point 1).
LOBBY_API_BASE_URL=
# Secret partagé avec le relais réseau (reverse-proxy Caddy, hors dépôt) qui expose LobbyPMS à IP
# stable — envoyé en en-tête X-Relay-Secret par lobbyClient.ts quand présent. Absente en local/test
# (pas de relais) ; requise dès que LOBBY_API_BASE_URL pointe vers le relais préprod/prod — sans
# elle, le relais refuse la requête (403), échec fermé voulu.
LOBBY_RELAY_SECRET=
