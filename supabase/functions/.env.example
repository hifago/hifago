# Secrets des Edge Functions — noms seulement, jamais de valeur commitée (CLAUDE.md §8.2).
# En préprod/prod : Dashboard → Edge Functions → Secrets, ou `supabase secrets set --project-ref`.
# Valeurs, sources et règles de chaque environnement : docs/runbook-environnements.md §3.1.
# Les SUPABASE_* (URL, clés) sont injectés d'office par Supabase : ne pas les poser.

# send-notification-emails
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=

# payments-reconcile — même token que MERCADOPAGO_ACCESS_TOKEN de hifago-web ; absent = échec fermé.
MERCADOPAGO_ACCESS_TOKEN=

# pms-* — le relais Vultr de l'environnement (infra/relay/README.md) ; absent = appel direct refusé par Lobby.
LOBBY_API_BASE_URL=
LOBBY_RELAY_SECRET=
