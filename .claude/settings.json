{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(supabase/migrations/*.sql)",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/inject-migration-checklist.mjs\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(supabase/migrations/*.sql)",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/inject-migration-checklist.mjs\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "if": "Read(**/docs/**)",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/guard-doc-read.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/post-edit-check-instructions.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/check-journal-updated.mjs\""
          }
        ]
      }
    ]
  }
}
